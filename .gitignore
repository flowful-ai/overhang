# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
__pycache__/
*.pyc
cad-worker/.venv/

# claude code user-specific settings
.claude/

# local docker compose override (machine-specific port mappings, dns, etc.)
docker-compose.override.yml
.superpowers/
docs/superpowers/
evals/results/

# Core dumps (e.g. from a cad-worker segfault)
core
cad-worker/core
