# OpenRouter API Key (Required)
# Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# URL for the Python CadQuery rendering service
CAD_WORKER_URL=http://localhost:8000

# CORS origins for cad-worker (comma-separated).
# Default restricts to the internal compose service. Only use * in local dev.
# Example: ALLOWED_ORIGINS=https://myapp.com,https://www.myapp.com
ALLOWED_ORIGINS=http://frontend:3000

# Execution timeout for CAD code in seconds, exec and export included
# (default: 30). The render's process is killed at this deadline.
EXEC_TIMEOUT=30

# Max simultaneous renders in the worker (default: 4). Over this, the worker
# sheds load with 503 instead of queueing so a few hung renders can't exhaust it.
# CAD_MAX_CONCURRENT_RENDERS=4

# Memory in MB each render's process may allocate on top of the preloaded
# CadQuery image (default: 1024). A render over it fails with an out-of-memory
# error instead of taking the worker down. Keep it at 512 or more.
# CAD_RENDER_MEMORY_MB=1024

# Number of trusted reverse proxies in front of the app that append to
# X-Forwarded-For. 0 for local installs (this template's value): forwarding
# headers are ignored and all callers share one rate-limit bucket. The client
# IP is the X-Forwarded-For entry this many hops from the right: 1 behind one
# reverse proxy (nginx, Caddy, Traefik), 2 behind a CDN plus a reverse proxy.
# docker-compose.yml falls back to 1 only when this key is absent from .env,
# so the value below wins for anyone who copied this file.
TRUST_PROXY=0

# Set to 1 to key on Cloudflare's CF-Connecting-IP header instead. Anyone who
# reaches the origin without Cloudflare can forge it, so only enable this when
# the origin is firewalled to Cloudflare's IP ranges or uses Authenticated
# Origin Pulls. The same firewall is what makes TRUST_PROXY safe.
# TRUST_CF_CONNECTING_IP=1

# Host interface docker compose publishes port 3000 on (default 127.0.0.1).
# Keeps other machines off port 3000; it does not protect your proxy's own
# public port. Set 0.0.0.0 only if another machine must reach the app
# directly, and firewall it to that machine.
# FRONTEND_BIND=127.0.0.1

# Max concurrent requests per endpoint pool, shared by all callers (renders
# and 3MF exports share one pool). Over it: 503. Default 4 for both. The older
# ANON_MAX_CONCURRENT_* names are still read as a fallback.
# MAX_CONCURRENT_GENERATIONS=4
# MAX_CONCURRENT_RENDERS=4

# Shared secret between the frontend and the cad-worker. Required by
# docker-compose.yml so nothing else on the docker network can drive arbitrary
# Python execution. Generate with `openssl rand -hex 32`.
# Set the SAME value on both services in docker-compose.
WORKER_SECRET=

# CAD worker log level
LOG_LEVEL=INFO

# Kill switch: set to 1 to force /api/generate-cad to return 503.
# Use during cost incidents or LLM provider outages.
# EMERGENCY_DISABLE_GENERATION=1

# Web search: the agent looks up real product specs through OpenRouter on the
# first step of a turn, for the models enabled in MODELS (src/lib/utils.ts).
# On when unset, empty, on, 1 or true; any other value (e.g. off) disables it
# for everyone and greys out the toggle in Settings.
# WEB_SEARCH=off
